{
  "manifest_version": 3,
  "name": "Trello Rich Checklist",
  "version": "2.0.0",
  "description": "Formátování položek checklistu v Trellu (tučné, odstavce, odznaky HOTOVO a EDIT) a export karet do Markdownu.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://trello.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://trello.com/*"],
    "js": ["rich-checklist/format.js", "rich-checklist/native-adapter.js", "rich-checklist/content.js"],
    "css": ["rich-checklist/content.css"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Trello to Markdown"
  }
}
